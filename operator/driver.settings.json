{
  "permissions": {
    "deny": [
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash",
      "PowerShell",
      "Monitor",
      "BashOutput",
      "KillShell",
      "Read",
      "Grep",
      "Glob",
      "Agent",
      "Task",
      "Workflow",
      "TaskOutput",
      "TaskStop",
      "SendMessage",
      "ListAgents",
      "ToolSearch",
      "Skill",
      "CronCreate",
      "CronDelete",
      "CronList",
      "ScheduleWakeup",
      "RemoteTrigger",
      "PushNotification",
      "DesignSync",
      "EnterWorktree",
      "ExitWorktree",
      "EnterPlanMode",
      "ExitPlanMode",
      "ReportFindings",
      "Artifact",
      "EndConversation",
      "AskUserQuestion",
      "LSP",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "ReadMcpResourceDirTool",
      "TodoWrite",
      "KillBash",
      "WebFetch"
    ],
    "allow": [
      "mcp__phosphor__*",
      "WebSearch"
    ],
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Phosphor reads pages with mcp__phosphor__web_read only, at an address a web search returned or the person gave. WebFetch is off.' >&2; exit 2"
          }
        ]
      }
    ]
  },
  "enableAllProjectMcpServers": false,
  "includeCoAuthoredBy": false
}
