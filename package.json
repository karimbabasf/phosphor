{
  "name": "phosphor",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Phosphor: local stablecoin control app driven by any MCP agent. The app is the car, the agent is the person with the key.",
  "scripts": {
    "app": "node src/main.ts",
    "mcp": "node src/mcp.ts",
    "keygen": "node scripts/keygen.ts",
    "keys:where": "node scripts/keys-where.ts",
    "near:prove": "node scripts/near-prove.ts",
    "sweep": "node scripts/sweep.ts",
    "intents-balance": "node scripts/intents-balance.ts",
    "hl-agent": "node scripts/hl-agent.ts",
    "test": "node --test tests/unit/*.test.ts tests/injection.test.ts tests/lockdown.test.ts",
    "e2e": "node scripts/e2e.ts",
    "typecheck": "tsc --noEmit",
    "bundle": "node scripts/bundle-payload.ts",
    "app:build": "npm run bundle && tauri build",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "viem": "^2.55.13",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.0"
  }
}
