{
  "name": "phosphor",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "description": "Phosphor: local stablecoin control app driven by any MCP agent. The app is the car, the agent is the person with the key.",
  "license": "FSL-1.1-MIT",
  "author": "Karim Baba",
  "homepage": "https://phosphor.karimbabasf.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karimbabasf/phosphor.git"
  },
  "bugs": {
    "url": "https://github.com/karimbabasf/phosphor/issues"
  },
  "scripts": {
    "app": "node src/main.ts",
    "mcp": "node src/mcp.ts",
    "keygen": "node scripts/keygen.ts",
    "keys:where": "node scripts/keys-where.ts",
    "sweep": "node scripts/sweep.ts",
    "intents-balance": "node scripts/intents-balance.ts",
    "hl-agent": "node scripts/hl-agent.ts",
    "venue-latency": "node scripts/venue-latency.ts",
    "latency-proof": "node scripts/latency-proof.ts",
    "test": "node --test tests/unit/*.test.ts tests/injection.test.ts tests/lockdown.test.ts",
    "e2e": "node scripts/e2e.ts",
    "eval": "node scripts/eval.ts",
    "eval:live": "node scripts/eval.ts --live",
    "typecheck": "tsc --noEmit",
    "bundle": "node scripts/bundle-payload.ts",
    "app:build": "npm run bundle && tauri build",
    "tauri": "tauri",
    "se:build": "sh scripts/build-se-helper.sh",
    "se:selftest": "node scripts/vault-selftest.ts",
    "se:e2e": "node scripts/vault-e2e.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "viem": "^2.55.13",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.0"
  }
}
