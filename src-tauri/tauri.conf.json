{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phosphor",
  "version": "0.9.1",
  "identifier": "com.karimbabasf.phosphor",
  "build": {
    "frontendDist": "../src-tauri/frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "category": "Finance",
    "shortDescription": "Local stablecoin control, driven by any MCP agent",
    "longDescription": "Phosphor is a local control app for stablecoins and onchain trading. It holds the keys, the policy and the approval surface, and exposes an MCP server so an agent you already pay for can drive it. The agent proposes; a human clicks. The agent can never approve its own actions.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "payload/phosphor": "phosphor"
    },
    "externalBin": [
      "binaries/node",
      "binaries/se-helper"
    ],
    "macOS": {
      "minimumSystemVersion": "13.5",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": { "width": 660, "height": 564 },
        "appPosition": { "x": 165, "y": 165 },
        "applicationFolderPosition": { "x": 495, "y": 165 }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/karimbabasf/phosphor/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCMkIyQTVDQUU2QTZGQjkKUldTNWIycXVYQ29ycTl5cCtudkFjT1dydHg1YnRSYm54ZkY4L2o3ankxT3JaOFdaZ3RWaDlzajYK"
    }
  }
}
